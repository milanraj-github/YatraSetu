# Application Settings
APP_NAME=SMARTBUS Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# PostgreSQL Database Settings
POSTGRES_USER=smartbus_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartbus_db
DATABASE_URL=postgresql+asyncpg://smartbus_user:your_secure_password@localhost:5432/smartbus_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Firebase Authentication Settings (Optional in local development / mocks in tests)
# Path to service account JSON file, e.g. ./firebase-service-account.json
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=smartbus-campus

# Push Notifications & Deduplication
FCM_ENABLED=true
NOTIFICATION_DEDUPE_TTL_SECONDS=1800

# ETA Engine
DEFAULT_ETA_SPEED_MPS=8.0

# Geofence Proximity Radii (meters)
BUS_NEARBY_RADIUS_METERS=500.0
BUS_ARRIVAL_RADIUS_METERS=100.0
